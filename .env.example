# App
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# Features
ENABLE_WHALE_TRACKING="true"
ENABLE_SMART_MONEY="true"
ENABLE_HYPERLIQUID="true"
ENABLE_BACKTESTING="true"
ENABLE_ALERTS="true"

# Logging
LOG_LEVEL="info"
