# Database
DATABASE_URL="postgresql://alphaflow:alphaflow123@postgres:5432/alphaflow"

# Redis
REDIS_URL="redis://redis:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
