# Database
DATABASE_URL="postgresql://alphaflow:alphaflow123@postgres:5432/alphaflow"
# Used by docker-compose to provision postgres (keep in sync with DATABASE_URL)
POSTGRES_USER="alphaflow"
POSTGRES_PASSWORD="alphaflow123"
POSTGRES_DB="alphaflow"

# Redis (optional — caching/pubsub degrade gracefully when unset)
REDIS_URL="redis://redis:6379"

# JWT — REQUIRED in production: minimum 32 characters, the app refuses to boot otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRY="7d"

# Bootstrap admin (consumed by `npm run db:seed`)
ADMIN_EMAIL="admin@alphaflow.local"
ADMIN_PASSWORD="ChangeMe123!"

# API Keys (all optional — adapters degrade gracefully when unconfigured)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

BYBIT_API_KEY=""
BYBIT_API_SECRET=""

HYPERLIQUID_API_KEY=""

COINGECKO_API_KEY=""

DEFI_LLAMA_API_URL="https://api.llama.fi"

# RPC Endpoints
ETHEREUM_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Social APIs
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

DISCORD_WEBHOOK_URL=""

# Email (SMTP) — channel is skipped when SMTP_HOST/SMTP_USER are unset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@alphaflow.io"
SMTP_TO=""

# App
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3000"
# CORS origin for /api routes (defaults to NEXT_PUBLIC_API_URL — never use *)
CORS_ALLOWED_ORIGIN=""

# Features
ENABLE_WHALE_TRACKING="true"
ENABLE_SMART_MONEY="true"
ENABLE_HYPERLIQUID="true"
ENABLE_BACKTESTING="true"
ENABLE_ALERTS="true"

# Logging
LOG_LEVEL="info"
